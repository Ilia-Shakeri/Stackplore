          "id": "oom_state",
          "type": "health",
          "observed_at": "2026-10-19T08:00:00.000000Z",
          "availability": "available",
          "completeness": "complete",
          "synthetic": true,
          "facts": [
            {
              "key": "exit_code",
              "value": 137
