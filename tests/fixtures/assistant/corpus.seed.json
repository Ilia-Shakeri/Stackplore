        "assertions": [
          {
            "id": "docker_oom_support",
            "kind": "must_support",
            "statement": {
              "en": "The provider recorded an out-of-memory kill and exit code 137.",
              "fa": "فراهم‌کننده کشته‌شدن به علت کمبود حافظه و کد خروج ۱۳۷ را ثبت کرده است."
            }
          },
          {
            "id": "docker_oom_forbid",
            "kind": "must_not_assert",
            "statement": {
              "en": "A new deployment caused the memory failure.",
              "fa": "یک استقرار تازه علت خطای حافظه بوده است."
            }
          }
        ]
      }
    },
