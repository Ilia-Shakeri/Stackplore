* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf

*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary

# Preserve exact upstream legal bytes, including original whitespace and line endings.
apps/api/licenses/modules/** -text -whitespace
apps/api/licenses/modules/manifest.json text eol=lf !whitespace

apps/web/public/licenses/packages/** -text -whitespace
apps/web/public/licenses/packages/manifest.json text eol=lf !whitespace
apps/web/licenses/upstream/** -text -whitespace

deploy/licenses/** -text -whitespace
