# Runtime profile: development, production, or test.
STACKPLORE_ENVIRONMENT=development

# Canonical API listener host and port.
STACKPLORE_HTTP_ADDRESS=127.0.0.1:8080

# The development web proxy keeps the browser Host header. Use this public
# origin with npm run dev. A standalone API defaults to its own listener origin;
# set the external origin for other edges. No path, query, or fragment is allowed.
STACKPLORE_PUBLIC_ORIGIN=http://127.0.0.1:5173

# No proxy is trusted by default. Use canonical, comma-separated CIDR prefixes
# with no spaces only when the listed edge controls all forwarding headers.
# STACKPLORE_TRUSTED_PROXY_PREFIXES=10.0.0.0/8

# Metrics also require the exact public origin and one verified client network.
STACKPLORE_METRICS_ALLOWED_PREFIXES=127.0.0.0/8,::1/128

# Structured process logging.
STACKPLORE_LOG_LEVEL=info
STACKPLORE_LOG_FORMAT=json

# Canonical private runtime directory. The PostgreSQL-backed server keeps only
# the local digest-key file here. Relative paths work only in development and
# test. Production needs a non-root absolute local path.
STACKPLORE_DATA_DIRECTORY=data

# PostgreSQL connection. Do not commit a real password. Production must set an
# explicit URL with sslmode=verify-full. Development may use the password-free
# local role shown here.
STACKPLORE_DATABASE_URL=postgresql://stackplore@127.0.0.1:5432/stackplore?sslmode=disable
STACKPLORE_DATABASE_MIN_CONNECTIONS=2
STACKPLORE_DATABASE_MAX_CONNECTIONS=32
STACKPLORE_DATABASE_CONNECT_TIMEOUT=5s
STACKPLORE_DATABASE_QUERY_TIMEOUT=10s
STACKPLORE_DATABASE_MIGRATION_TIMEOUT=2m
STACKPLORE_DATABASE_HEALTH_TIMEOUT=2s

# Live sources are opt-in. Docker uses one local Unix socket and read-only
# Engine calls. Kubernetes uses the mounted service-account token and CA, and
# never lists Secret or ConfigMap bodies.
STACKPLORE_DOCKER_ENABLED=false
STACKPLORE_DOCKER_ACCESS_PROFILE=docker_socket_dev
STACKPLORE_DOCKER_SOCKET_PATH=/var/run/docker.sock
# Production: use docker_restricted_proxy and all four mounted-file/origin inputs.
# STACKPLORE_DOCKER_PROXY_ORIGIN=https://docker-proxy:2376
# STACKPLORE_DOCKER_PROXY_CA_FILE=/run/docker-client/ca.crt
# STACKPLORE_DOCKER_PROXY_CERT_FILE=/run/docker-client/client.crt
# STACKPLORE_DOCKER_PROXY_KEY_FILE=/run/docker-client/client.key
STACKPLORE_KUBERNETES_ENABLED=false
# Required when enabled: one to 64 explicit namespace names, comma-separated.
# STACKPLORE_KUBERNETES_NAMESPACES=application,operations
STACKPLORE_KUBERNETES_CLUSTER_OBSERVATION=false
STACKPLORE_KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
STACKPLORE_KUBERNETES_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
STACKPLORE_MUTATIONS_ENABLED=false
STACKPLORE_DOCKER_WRITE_ENABLED=false
STACKPLORE_KUBERNETES_WRITE_ENABLED=false

# Isolated demonstration requires a separate empty database and private root.
# Use a fresh private environment file per docs/demo.md; real-provider and
# outbound keys from this normal-install example must not be inherited.
# STACKPLORE_DEMO_DEPLOYMENT=true
# STACKPLORE_GUEST_DEMO=true
# STACKPLORE_DEMO_DATA_DIRECTORY=<absolute-private-demo-directory>

# Generic webhook delivery is opt-in. The URL and 32-byte unpadded base64url
# signing key must come from an operator-managed secret store. Never commit real
# values. The reference is a safe stable label stored with delivery records.
STACKPLORE_WEBHOOK_ENABLED=false
# STACKPLORE_WEBHOOK_DESTINATION_REFERENCE_ID=webhook_primary
# STACKPLORE_WEBHOOK_URL=https://hooks.example.invalid/stackplore
# STACKPLORE_WEBHOOK_SIGNING_KEY=<43-character-base64url-key>

# Matrix is opt-in. One exact homeserver origin, room ID, and access token come
# from the operator secret store. No discovery, redirect, or browser editing.
STACKPLORE_MATRIX_ENABLED=false
# STACKPLORE_MATRIX_DESTINATION_REFERENCE_ID=matrix_primary
# STACKPLORE_MATRIX_ORIGIN=https://matrix.example.invalid
# STACKPLORE_MATRIX_ROOM_ID=!room:example.invalid
# STACKPLORE_MATRIX_ACCESS_TOKEN=<operator-secret>

# An empty installation exposed beyond loopback needs one canonical 32-byte
# unpadded base64url proof and a paired canonical UTC expiry no more than one
# hour in the future. Keep both absent after the first administrator is made.
# STACKPLORE_SETUP_BOOTSTRAP_PROOF=<43-character-one-use-proof>
# STACKPLORE_SETUP_BOOTSTRAP_EXPIRES_AT=2026-08-02T12:30:00Z

# Server and request deadlines. Keep request timeout shorter than write timeout.
STACKPLORE_HTTP_READ_HEADER_TIMEOUT=5s
STACKPLORE_HTTP_READ_TIMEOUT=15s
STACKPLORE_HTTP_WRITE_TIMEOUT=30s
STACKPLORE_HTTP_IDLE_TIMEOUT=60s
STACKPLORE_HTTP_REQUEST_TIMEOUT=15s
STACKPLORE_HTTP_SHUTDOWN_TIMEOUT=15s

# Request, response, and concurrency bounds.
STACKPLORE_HTTP_MAX_HEADER_BYTES=32768
STACKPLORE_HTTP_MAX_REQUEST_BODY_BYTES=262144
STACKPLORE_HTTP_MAX_RESPONSE_BYTES=16777216
STACKPLORE_HTTP_MAX_CONNECTIONS=512
STACKPLORE_HTTP_MAX_IN_FLIGHT=256

# Per-client token-bucket defaults for non-operational HTTP requests.
STACKPLORE_RATE_LIMIT_PER_SECOND=20
STACKPLORE_RATE_LIMIT_BURST=40
STACKPLORE_RATE_LIMIT_MAX_CLIENTS=4096

# Vite proxy target. Keep the browser on the Vite origin during development.
STACKPLORE_DEV_API_ORIGIN=http://127.0.0.1:8080
