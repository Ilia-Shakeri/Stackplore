{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["api", "service", "ingress"],
  "properties": {
    "api": {
      "type": "object",
      "required": [
        "replicaCount",
        "publicOrigin",
        "existingSecret",
        "databaseURLKey",
        "databaseTLS",
        "setup",
        "kubernetes",
        "webhook",
        "matrix",
        "image",
        "persistence"
      ],
      "properties": {
        "replicaCount": { "type": "integer", "const": 1 },
        "publicOrigin": { "type": "string", "pattern": "^https://[^/?#]+$" },
        "existingSecret": { "type": "string", "minLength": 1 },
        "databaseURLKey": { "type": "string", "minLength": 1 },
        "logRedactFields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
        },
        "databaseTLS": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "caSecretName", "caCertificateKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "caSecretName": { "type": "string", "minLength": 1, "maxLength": 253 },
            "caCertificateKey": { "type": "string", "minLength": 1, "maxLength": 253 }
          }
        },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "proofSecretKey", "expirySecretKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "proofSecretKey": { "type": "string", "minLength": 1, "maxLength": 253 },
            "expirySecretKey": { "type": "string", "minLength": 1, "maxLength": 253 }
          }
        },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespaces", "clusterObservation"],
          "properties": {
            "enabled": { "type": "boolean" },
            "clusterObservation": { "type": "boolean" },
            "namespaces": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } } },
              "then": { "properties": { "namespaces": { "minItems": 1 } } }
            }
          ]
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "destinationReferenceId", "urlSecretKey", "signingKeySecretKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "destinationReferenceId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "urlSecretKey": { "type": "string", "minLength": 1, "maxLength": 253 },
            "signingKeySecretKey": { "type": "string", "minLength": 1, "maxLength": 253 }
          }
        },
        "matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "destinationReferenceId",
            "originSecretKey",
            "roomIdSecretKey",
            "accessTokenSecretKey"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "destinationReferenceId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "originSecretKey": { "type": "string", "minLength": 1, "maxLength": 253 },
            "roomIdSecretKey": { "type": "string", "minLength": 1, "maxLength": 253 },
            "accessTokenSecretKey": { "type": "string", "minLength": 1, "maxLength": 253 }
          }
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$" }
          }
        }
      }
    }
  }
}
