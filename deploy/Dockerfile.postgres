FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS gosu-build
WORKDIR /src
ADD --checksum=sha256:33d7537d588ea49458b9509bcf4554bdf5ceacc66da71e5caa1058ea3b689c3b https://codeload.github.com/tianon/gosu/tar.gz/6456aaa0f3c854d199d0f037f068eb97515b7513 /tmp/gosu.tar.gz
RUN tar -xzf /tmp/gosu.tar.gz --strip-components=1 && \
    test "$(go env GOVERSION)" = 'go1.26.10' && \
    grep -qx 'const Version = "1.19"' version.go && \
    go mod download && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/gosu . && \
    mkdir -p /out/licenses/gosu /out/licenses/moby-sys-user /out/licenses/golang-x-sys /out/licenses/golang && \
    cp LICENSE go.mod go.sum /out/licenses/gosu/ && \
    cp /go/pkg/mod/github.com/moby/sys/user@v0.1.0/LICENSE /out/licenses/moby-sys-user/ && \
    cp /go/pkg/mod/golang.org/x/sys@v0.1.0/LICENSE /go/pkg/mod/golang.org/x/sys@v0.1.0/PATENTS /out/licenses/golang-x-sys/ && \
    cp /usr/local/go/LICENSE /usr/local/go/PATENTS /out/licenses/golang/

FROM postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
COPY --from=gosu-build --chmod=0755 /out/gosu /usr/local/bin/gosu
COPY --from=gosu-build /out/licenses/ /usr/share/licenses/stackplore-postgres/
COPY deploy/licenses/postgresql/COPYRIGHT /usr/share/licenses/stackplore-postgres/postgresql/COPYRIGHT
