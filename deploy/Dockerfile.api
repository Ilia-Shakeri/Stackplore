# syntax=docker/dockerfile:1.8
FROM node:24.18.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS web-build
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY apps/web/ apps/web/
COPY packages/api-client/ packages/api-client/
COPY packages/ui/ packages/ui/
COPY scripts/check-web-notices.mjs scripts/legal-file-name.mjs scripts/
RUN node scripts/check-web-notices.mjs && pnpm --filter @stackplore/web build

FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS build
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY apps/api/ .
RUN rm -rf /src/internal/webui/static/*
COPY --from=web-build /src/apps/web/dist/ /src/internal/webui/static/
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/stackplore-server ./cmd/server

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 10001 stackplore && \
    adduser -S -D -H -u 10001 -G stackplore stackplore && \
    install -d -o stackplore -g stackplore -m 0700 /var/lib/stackplore
COPY --from=build --chown=10001:10001 /out/stackplore-server /usr/local/bin/stackplore-server
COPY apps/api/licenses/ /usr/share/licenses/stackplore/go/
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/licenses/stackplore/
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/stackplore-server"]
