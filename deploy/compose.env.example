# Copy to .env. Use a strong local-only value. URL-encode its password part.
STACKPLORE_COMPOSE_DATABASE_PASSWORD=replace-with-local-password
STACKPLORE_COMPOSE_DATABASE_URL=postgresql://stackplore:replace-with-url-encoded-local-password@postgres:5432/stackplore?sslmode=disable
STACKPLORE_COMPOSE_PORT=8080

# Optional generic webhook. Get both secret values from the receiving service.
STACKPLORE_WEBHOOK_ENABLED=false
# STACKPLORE_WEBHOOK_DESTINATION_REFERENCE_ID=webhook_primary
# STACKPLORE_WEBHOOK_URL=https://hooks.example.invalid/stackplore
# STACKPLORE_WEBHOOK_SIGNING_KEY=<43-character-base64url-key>
